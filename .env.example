# ── Bolt Sentinel environment ──────────────────────────────────────────────
# Copy to `.env` and fill in. Local dev needs only ANTHROPIC_API_KEY + DATABASE_URL.

# Anthropic API (required for all AI operations — live calls)
ANTHROPIC_API_KEY=

# Database
# Local dev: a SQLite file. Prisma migrations run against this.
DATABASE_URL="file:./dev.db"
# Production (Turso / libSQL). When TURSO_DATABASE_URL is set, the Prisma libSQL
# adapter is used at runtime instead of DATABASE_URL.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Document storage
# local-fs (default in dev) | vercel-blob (default in prod when token present)
STORAGE_DRIVER=local-fs
STORAGE_ROOT=./storage
BLOB_READ_WRITE_TOKEN=

# Sessions (sign opaque session tokens)
SESSION_SECRET="dev-secret-change-me"

# Seed anchor date — all synthetic validity windows are computed relative to this,
# so expiries/anomalies stay "live". Pin for reproducible demos.
SEED_ANCHOR="2026-06-04"

# Protects /api/admin/seed and /api/cron/* on a deployed instance
ADMIN_TOKEN="dev-admin-token"
CRON_SECRET="dev-cron-secret"
